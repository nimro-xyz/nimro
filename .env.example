# Every variable is optional. Copy to .env.local (never commit it) only if you want to override a default.
# Server RPC for Robinhood Chain reads (default: public RPC)
ROBINHOOD_RPC_URL=
# Browser RPC (default: public RPC)
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
# WalletConnect Cloud project id (without it the WalletConnect option says "not configured")
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Shared key-value store for rate limits across server instances (without it limits are per instance)
KV_REST_API_URL=
KV_REST_API_TOKEN=
